# Copy to .env for local dev. On Render, set these in the service's Environment tab.

# Render Postgres — use the Internal Database URL on Render.
# Locally, use the External URL and set PGSSL=true.
DATABASE_URL=
PGSSL=false

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# Optional
# PORT=3000
# UPLOAD_DIR=/tmp/darpan-uploads
# MAX_UPLOAD_MB=200
# UPLOAD_TTL_MINUTES=60
